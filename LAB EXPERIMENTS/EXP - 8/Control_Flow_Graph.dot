digraph ControlFlowGraph {
  rankdir=TB; node [shape=box, style="rounded", fontname="Arial"];
  1 [label="1 Start", shape=oval];
  2 [label="2 Input n"];
  3 [label="3 n > 0?", shape=diamond];
  4 [label="4 Print positive"];
  5 [label="5 n % 2 = 0?", shape=diamond];
  6 [label="6 Print even"];
  7 [label="7 n % 3 = 0?", shape=diamond];
  8 [label="8 Print divisible by 3"];
  9 [label="9 Print remaining result"];
  10 [label="10 End", shape=oval];
  1 -> 2; 2 -> 3;
  3 -> 4 [label="Yes"]; 3 -> 5 [label="No"]; 4 -> 5;
  5 -> 6 [label="Yes"]; 5 -> 7 [label="No"]; 6 -> 7;
  7 -> 8 [label="Yes"]; 7 -> 9 [label="No"]; 8 -> 9; 9 -> 10;
}